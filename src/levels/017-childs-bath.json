  "art": {
    "slug": "the-child-s-bath-cassatt",
    "title": "The Child's Bath",
    "artist": "Mary Cassatt",
    "year": "1893",
    "holder": "Art Institute of Chicago",
    "credit": "CC0 · Art Institute of Chicago",
    "story": "A woman holds a little girl on her lap and gently washes her feet in a basin, the jug waiting beside them. We look down on them from above, a view Mary Cassatt learned from Japanese prints, along with the bold flat patterns of the striped dress, the rug and the wall. Cassatt was an American in Paris and the only American asked to show with the Impressionists. She painted the quiet, everyday life of women and children, and made it monumental."
